[Unit]
Description=Papanda verified release
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=papanda
Group=papanda
WorkingDirectory=/opt/papanda
ExecStart=/usr/bin/python3.12 /opt/papanda/launcher.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
