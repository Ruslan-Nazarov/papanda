# Local personal editor; no API keys are needed for manual notes.
DEMO_MODE=false
# DATABASE_URL=sqlite+aiosqlite:///./data/db/papanda.db
# DB_DIR=./data/db
# DEMO_DIR=./data/demo

# Generated at startup if empty. Currently not used for JWT/session signing.
SECRET_KEY=

# Optional providers. Configure only the accounts you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem

# Local direct connection; reverse-proxy trust requires deployment configuration.
TRUSTED_PROXY_COUNT=0
SESSION_DAILY_GENERATION_CAP=40
GLOBAL_DAILY_GENERATION_CAP=3000
