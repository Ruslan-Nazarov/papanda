# Local personal editor; no API keys are needed for manual notes.
DEMO_MODE=false
HOST=127.0.0.1
PORT=8080
UVICORN_RELOAD=0
WEB_CONCURRENCY=1
# Managed deployment sets PAPANDA_ENV_FILE and absolute DATA_DIR/DB_DIR/DEMO_DIR.
# Its launcher manages PAPANDA_READY_FILE; do not set it for local development.
# DATABASE_URL=sqlite+aiosqlite:///./data/db/papanda.db
# DB_DIR=./data/db
# DEMO_DIR=./data/demo

# Legacy application secret, generated at startup if empty.
# Demo identity uses opaque random tokens checked in the server registry.
SECRET_KEY=

# Optional providers. Configure only the accounts you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# OpenAI is used only by the dialectic_v3 engine (first in its provider chain, model below).
OPENAI_API_KEY=
DIALECTIC_OPENAI_MODEL=gpt-5-mini
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true
# Optional model overrides: GROQ_MODEL, GROQ_ALT_MODEL, GROQ_FAST_MODEL,
# CEREBRAS_MODEL, CEREBRAS_FAST_MODEL, GOOGLE_MODEL, GOOGLE_FAST_MODEL,
# OPENROUTER_MODEL, GIGACHAT_MODEL, GIGACHAT_FAST_MODEL.
# Download the official CA with scripts/download_gigachat_ca.py if needed.
# GIGACHAT_CA_BUNDLE=data/certs/russian_trusted_root_ca.pem

# Conspectus and step engine: dialectic_v3 (default) or legacy (explicit rollback).
GENERATION_ENGINE=dialectic_v3

# One generation operation, including provider fallback and all retries.
# dialectic_v3 makes 8+ sequential model calls (~290s on gpt-5-mini), so 300 is too tight.
GENERATION_TIMEOUT=900
GENERATION_MAX_CALLS=60
# Conservative reservation: UTF-8 input bytes plus requested output tokens.
GENERATION_MAX_TOKENS=1500000
GENERATION_CONCURRENCY=2

# Local direct connection; reverse-proxy trust requires deployment configuration.
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_IPS=
SESSION_DAILY_GENERATION_CAP=40
GLOBAL_DAILY_GENERATION_CAP=3000
IP_DAILY_GENERATION_CAP=80

# Anonymous browser storage: exactly one process, HTTPS at the trusted proxy.
# Activity renews cookie and server lifetime. Data deletion requires explicit opt-in.
DEMO_SESSION_TTL_SECONDS=2592000
DEMO_DELETE_EXPIRED_DATA=false
DEMO_MAX_SESSIONS=0
DEMO_MAX_DB_BYTES=33554432
MAX_CACHED_ENGINES=32

MAX_REQUEST_BYTES=12582912
MAX_UPLOAD_BYTES=8388608
MAX_URL_BYTES=2097152
PDF_MAX_PAGES=50
PDF_TIMEOUT_SECONDS=15
PDF_MEMORY_BYTES=536870912
# Авторская библиотека. Локально DEMO_MODE=false; на сервере DEMO_MODE=true.
# Без URL кнопки публикуют только в локальную библиотеку.
LIBRARY_PUBLISH_URL=
# Одинаковый случайный ключ локально и на сервере; никогда не коммитить .env.
LIBRARY_PUBLISH_KEY=
