# Секретный ключ для подписи JWT токенов (сгенерируйте свой! Например: openssl rand -hex 32)
SECRET_KEY=yoursecretkeyhere

# Режим "только конспекты" (при true отключает другие модули papanda, если они есть)
ENABLE_ONLY_NOTES=true

# Демонстрационный режим (песочница без регистрации). По умолчанию false.
DEMO_MODE=false

# Ссылка на базу данных (по умолчанию SQLite в папке data/db/papanda.db)
# Оставьте закомментированным для использования значения по умолчанию
# DATABASE_URL=sqlite+aiosqlite:///./data/db/papanda.db

# Путь к папке данных (если хотите изменить стандартное расположение)
# DATA_DIR=./data

# Ключ для вызова Groq API (ОБЯЗАТЕЛЕН для работы AI-функций)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
